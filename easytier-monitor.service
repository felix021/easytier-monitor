[Unit]
Description=EasyTier Health Monitor
After=network.target easytier.service
Wants=easytier.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/felix021/docker/easytier/easytier-monitor/monitor.py --cli /usr/bin/easytier-cli --fd-unit easytier.service
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
